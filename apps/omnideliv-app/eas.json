{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_GATEWAY_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_OMNIDELIV_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "demo"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GATEWAY_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_OMNIDELIV_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "demo"
      }
    },
    "preview-ph": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GATEWAY_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_OMNIDELIV_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "cargomarket-ph"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_GATEWAY_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_OMNIDELIV_API": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "demo"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
