{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_IDENTITY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_COMPLIANCE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ORDER_INTAKE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_DELIVERY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_PAYMENTS_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ENGAGEMENT_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_AI_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "demo"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_IDENTITY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_COMPLIANCE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ORDER_INTAKE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_DELIVERY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "cargomarket-ph",
        "EXPO_PUBLIC_PAYMENTS_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ENGAGEMENT_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_AI_URL": "https://os-api.cargomarket.net"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_IDENTITY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_COMPLIANCE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ORDER_INTAKE_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_DELIVERY_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_TENANT_SLUG": "cargomarket-ph",
        "EXPO_PUBLIC_PAYMENTS_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_ENGAGEMENT_URL": "https://os-api.cargomarket.net",
        "EXPO_PUBLIC_AI_URL": "https://os-api.cargomarket.net"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal"
      }
    }
  }
}
