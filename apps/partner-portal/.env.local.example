# ── Auth ──────────────────────────────────────────────────────────────────────
# Firebase Client (public — safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=logisticos-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logisticos-prod
NEXT_PUBLIC_FIREBASE_APP_ID=1:123:web:abc

# Firebase Admin (server only — NEVER expose to browser)
FIREBASE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=

# Landing app URL (used for auth redirects)
LANDING_URL=https://os.cargomarket.net

# ── Backend service URLs ───────────────────────────────────────────────────────
# In production point these at the Envoy API gateway or Istio virtual services.
# In local dev each service runs on its own port (see docker-compose.yml).

# API gateway — primary entry point for all authenticated API calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# Carrier & Partner Management (service 10) — carrier profiles, SLA, rate
# cards, marketplace listings, bookings, webhooks
NEXT_PUBLIC_CARRIER_URL=http://localhost:8010

# Dispatch & Routing (service 5) — dispatch queue, driver assignment
NEXT_PUBLIC_DISPATCH_URL=http://localhost:8005

# Driver Operations (service 6) — driver roster, task manifest
NEXT_PUBLIC_DRIVER_OPS_URL=http://localhost:8006

# Order & Shipment Intake (service 4) — shipment lookup fallback
NEXT_PUBLIC_ORDER_INTAKE_URL=http://localhost:8004

# Payments & Billing (service 12) — wallet, invoices, transactions
NEXT_PUBLIC_PAYMENTS_URL=http://localhost:8012

# Analytics & BI (service 13) — KPI timeseries, SLA trend data
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8013
