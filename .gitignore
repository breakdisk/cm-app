# Rust
target/
# Cargo.lock is intentionally committed for reproducible Docker builds

# Environment
.env
.env.local
.env.*.local

# Node / JS
node_modules/
.next/
.turbo/
dist/
build/
out/
*.tsbuildinfo

# React Native
.expo/
android/
ios/
*.keystore

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Infra / Secrets
infra/terraform/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
*.pem
*.key
*.crt

# Logs
*.log
logs/

# Coverage
coverage/
lcov.info

# Docker
docker-compose.override.yml

# Generated
libs/sdk/generated/
libs/proto/src/generated/

# Git worktrees
.worktrees/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Local Claude overrides (personal dev notes, not shared)
.claude.local.md
.claire/
.clone/
.playwright-mcp/
.cargo/

# Android (driver-app-android) — build output and local tooling
apps/driver-app-android/.gradle/
apps/driver-app-android/build/
apps/driver-app-android/**/build/
apps/driver-app-android/local.properties
# gradle-wrapper.jar and gradlew must be committed — CI needs them to build the APK
apps/driver-app-android/gradle/gradle-daemon-jvm.properties

# Firebase / Google service account secrets
google-services.json
**/google-services.json
agenticlogistic-firebase-adminsdk-*.json
*-firebase-adminsdk-*.json

# APK drop folders — build artifacts belong in GitHub Releases, not the source tree
apk-*/
driver-app-*-release-*/
driver-app-*-debug-*/
*.apk

# Office documents / spreadsheets at repo root (use docs/ or a shared drive instead)
/*.xlsx
/*.xls
/*.csv
/*.docx
/*.pptx

# Keystore files (signing keys must never enter source control)
*.jks
*.keystore
# Signing credentials — CI supplies these via GitHub Secrets
# (KEYSTORE_BASE64 / KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD),
# so they must never be committed. See app/build.gradle.kts signingConfigs.
android_key_alias.txt
android_key_password.txt
android_keystore_password.txt
# Local crash dumps can contain tokens and PII
crash.txt
