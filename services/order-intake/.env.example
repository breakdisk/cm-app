APP__HOST=0.0.0.0
APP__PORT=8000
APP__ENV=development
# Comma-separated allowed CORS origins. Set in production to your portal URLs.
# e.g. APP__CORS_ORIGINS=https://os.cargomarket.net,https://admin.cargomarket.net
APP__CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Base URL merchants/customers are redirected back to after hosted checkout
# for a payment-gated shipment. Optional, together with PAYMENTS__URL and
# QUOTE_TOKEN_SECRET below — "pay online at booking" is one capability,
# disabled unless all three are set (see Config::payment_config()). The
# service still boots and takes normal cash bookings without it.
APP__PUBLIC_BASE_URL=http://localhost:3001

DATABASE__URL=postgres://logisticos:password@localhost:5432/logisticos
DATABASE__MAX_CONNECTIONS=10

REDIS__URL=redis://localhost:6379

KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=order-intake

# Base URL of the payments service. Optional, together with
# QUOTE_TOKEN_SECRET and APP__PUBLIC_BASE_URL — see the note above.
PAYMENTS__URL=http://localhost:8012

AUTH__JWT_SECRET=change-me-in-production

# Optional: Mapbox token for address geocoding
GEOCODER__MAPBOX_ACCESS_TOKEN=

# HMAC-SHA256 signing secret for short-TTL quote tokens. Optional, together
# with PAYMENTS__URL and APP__PUBLIC_BASE_URL above — see the note on
# APP__PUBLIC_BASE_URL. Unset disables online payment at booking only.
QUOTE_TOKEN_SECRET=change-me-in-production
