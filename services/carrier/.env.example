APP__HOST=0.0.0.0
APP__PORT=8010
APP__ENV=development

DATABASE__URL=postgres://logisticos:password@localhost:5432/svc_carrier
DATABASE__MAX_CONNECTIONS=5

REDIS__URL=redis://localhost:6379

KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=carrier-dev

AUTH__JWT_SECRET=dev-jwt-secret-REPLACE-WITH-32CHAR-RANDOM-VALUE-123

# ── 3PL Carrier Credentials ───────────────────────────────────────────────────
# Only adapters with credentials present are registered at startup.

# DHL Express — MyDHL+ REST API
# Sandbox: https://api-sandbox.dhl.com  |  Production: https://api.dhl.com
CARRIERS__DHL__BASE_URL=https://api-sandbox.dhl.com
CARRIERS__DHL__ACCOUNT_NUMBER=
CARRIERS__DHL__API_KEY=
CARRIERS__DHL__API_SECRET=

# FedEx REST API
CARRIERS__FEDEX__BASE_URL=https://apis-sandbox.fedex.com
CARRIERS__FEDEX__CLIENT_ID=
CARRIERS__FEDEX__CLIENT_SECRET=
CARRIERS__FEDEX__ACCOUNT_NUMBER=

# UPS REST API
CARRIERS__UPS__BASE_URL=https://wwwcie.ups.com
CARRIERS__UPS__CLIENT_ID=
CARRIERS__UPS__CLIENT_SECRET=
CARRIERS__UPS__ACCOUNT_NUMBER=

# TNT (routes through FedEx OAuth2 infra)
CARRIERS__TNT__BASE_URL=https://apis-sandbox.fedex.com
CARRIERS__TNT__CLIENT_ID=
CARRIERS__TNT__CLIENT_SECRET=
CARRIERS__TNT__ACCOUNT_NUMBER=

# DPD REST API
CARRIERS__DPD__BASE_URL=https://api.dpd.com
CARRIERS__DPD__USERNAME=
CARRIERS__DPD__PASSWORD=
CARRIERS__DPD__ACCOUNT=

# Aramex REST API
CARRIERS__ARAMEX__BASE_URL=https://ws.aramex.net
CARRIERS__ARAMEX__USERNAME=
CARRIERS__ARAMEX__PASSWORD=
CARRIERS__ARAMEX__VERSION=v1
CARRIERS__ARAMEX__ENTITY=
CARRIERS__ARAMEX__ACCOUNT_NUMBER=
CARRIERS__ARAMEX__ACCOUNT_PIN=
CARRIERS__ARAMEX__ACCOUNT_COUNTRY_CODE=PH

# ── Sibling Services ──────────────────────────────────────────────────────────
# Used by the allocation booking worker to fetch shipment details.
SERVICES__ORDER_INTAKE_URL=http://localhost:8004

# ── Object Storage (Cloudflare R2 / MinIO / AWS S3) ──────────────────────────
# Stores carrier label PDFs and generates presigned download URLs.
# For Cloudflare R2: S3__ACCESS_KEY_ID must be exactly 32 chars.
S3_BUCKET=logisticos-carrier-labels
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3__ACCESS_KEY_ID=
S3__SECRET_ACCESS_KEY=

RUST_LOG=info,sqlx=warn
