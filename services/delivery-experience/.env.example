APP__HOST=0.0.0.0
APP__PORT=8007
APP__ENV=development
DATABASE__URL=postgres://logisticos:password@localhost:5432/svc_delivery_experience
DATABASE__MAX_CONNECTIONS=5
REDIS__URL=redis://localhost:6379
KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=delivery-experience-dev
AUTH__JWT_SECRET=dev-jwt-secret-REPLACE-WITH-32CHAR-RANDOM-VALUE-123
AUTH__JWT_EXPIRY_SECONDS=3600
AUTH__REFRESH_TOKEN_EXPIRY_SECONDS=86400

# Pod service internal URL — used to fetch POP/POD photo evidence and inject it
# into tracking responses for the merchant portal Delivery Receipt Modal.
# Local dev: pod service runs on port 8011. Docker Compose: use http://pod:8011.
POD_INTERNAL_URL=http://localhost:8011

RUST_LOG=info,sqlx=warn
