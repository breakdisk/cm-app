APP__HOST=0.0.0.0
APP__PORT=8011
APP__ENV=development

DATABASE__URL=postgres://logisticos:password@localhost:5432/svc_pod
DATABASE__MAX_CONNECTIONS=5

KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=pod-dev

AUTH__JWT_SECRET=dev-jwt-secret-REPLACE-WITH-32CHAR-RANDOM-VALUE-123
AUTH__JWT_EXPIRY_SECONDS=3600
AUTH__REFRESH_TOKEN_EXPIRY_SECONDS=86400

REDIS__URL=redis://localhost:6379

# Cloudflare R2 — separate buckets for POD and POP evidence
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=logisticos-pod-photos
POP_S3_BUCKET=logisticos-pop-photos
S3_REGION=auto
# R2 access key (must be exactly 32 chars)
S3__ACCESS_KEY_ID=
S3__SECRET_ACCESS_KEY=

# Twilio OTP SMS (optional — NoOp adapter used if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SERVICES__IDENTITY_URL=http://localhost:8001
SERVICES__CDP_URL=http://localhost:8002
SERVICES__ENGAGEMENT_URL=http://localhost:8003
SERVICES__ORDER_INTAKE_URL=http://localhost:8004
SERVICES__DISPATCH_URL=http://localhost:8005
SERVICES__DRIVER_OPS_URL=http://localhost:8006
SERVICES__DELIVERY_EXPERIENCE_URL=http://localhost:8007
SERVICES__FLEET_URL=http://localhost:8008
SERVICES__HUB_OPS_URL=http://localhost:8009
SERVICES__CARRIER_URL=http://localhost:8010
SERVICES__POD_URL=http://localhost:8011
SERVICES__PAYMENTS_URL=http://localhost:8012
SERVICES__ANALYTICS_URL=http://localhost:8013
SERVICES__MARKETING_URL=http://localhost:8014
SERVICES__BUSINESS_LOGIC_URL=http://localhost:8015
SERVICES__AI_LAYER_URL=http://localhost:8016
