APP__HOST=0.0.0.0
APP__PORT=8012
APP__ENV=development

DATABASE__URL=postgres://logisticos:password@localhost:5432/logisticos
DATABASE__MAX_CONNECTIONS=10

REDIS__URL=redis://localhost:6379

KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=payments

# Base URL of the order-intake service (billing/COD queries).
ORDER_INTAKE__URL=http://localhost:8004

AUTH__JWT_SECRET=change-me-in-production

# Network International (online card payment gateway) — optional. These four
# are only meaningful together: leave any one unset and online card payment
# is disabled entirely (POST /v1/internal/payments/intents and POST
# /v1/payments/webhooks/network-international both answer 503), logged once
# at WARN on startup. Invoicing, COD, wallets, driver ledger, and billing all
# boot and work with none of these set — see Config::network_international in
# services/payments/src/config.rs.
NETWORK_INTERNATIONAL__BASE_URL=
NETWORK_INTERNATIONAL__API_KEY=
NETWORK_INTERNATIONAL__WEBHOOK_SECRET=
NETWORK_INTERNATIONAL__OUTLET_REF=
