APP__HOST=0.0.0.0
APP__PORT=8012
APP__ENV=development

DATABASE__URL=postgres://logisticos:password@localhost:5432/logisticos
DATABASE__MAX_CONNECTIONS=10

REDIS__URL=redis://localhost:6379

KAFKA__BROKERS=localhost:9092
KAFKA__GROUP_ID=payments

# Base URL of the order-intake service (billing/COD queries).
ORDER_INTAKE__URL=http://localhost:8004

AUTH__JWT_SECRET=change-me-in-production

# Network International (online card payment gateway) — optional.
# BASE_URL / API_KEY / OUTLET_REF are only meaningful together: leave any one
# unset and online card payment is disabled entirely (POST
# /v1/internal/payments/intents and POST
# /v1/payments/webhooks/network-international both answer 503), logged once
# at WARN on startup. Invoicing, COD, wallets, driver ledger, and billing all
# boot and work with none of these set — see Config::network_international in
# services/payments/src/config.rs.
#
# When those three ARE set, webhook verification additionally requires
# EITHER WEBHOOK_SECRET OR the WEBHOOK_HEADER_KEY + WEBHOOK_HEADER_VALUE pair
# below (not neither) — the service refuses to start otherwise, rather than
# accepting NI webhooks unverified:
#   - WEBHOOK_SECRET: HMAC-SHA256 over the raw webhook body, sent back as the
#     `x-ni-signature` header.
#   - WEBHOOK_HEADER_KEY / WEBHOOK_HEADER_VALUE: NI's portal-configured
#     static "Header Key" / "Header Value" pair, attached verbatim to every
#     webhook call instead of a body signature.
# Which mode a given NI account actually uses is not yet confirmed against a
# live sandbox — both are supported so the integration works either way; see
# scripts/ni-sandbox-verify.py.
#
# NI's real webhook body is nested (order.reference,
# order._embedded.payment[0].state, ...), not the flat shape originally
# assumed — see network_international.rs, parsed tolerantly with fallbacks.
# It may also be AES-256-CBC encrypted if an "Encryption Key" is set in NI's
# portal: set WEBHOOK_ENCRYPTION_KEY below (exactly 32 characters — a
# wrong-length key fails startup rather than every webhook at runtime).
NETWORK_INTERNATIONAL__BASE_URL=
NETWORK_INTERNATIONAL__API_KEY=
NETWORK_INTERNATIONAL__WEBHOOK_SECRET=
NETWORK_INTERNATIONAL__OUTLET_REF=
NETWORK_INTERNATIONAL__WEBHOOK_HEADER_KEY=
NETWORK_INTERNATIONAL__WEBHOOK_HEADER_VALUE=
NETWORK_INTERNATIONAL__WEBHOOK_ENCRYPTION_KEY=
