APP__HOST=0.0.0.0
APP__PORT=8000
APP__ENV=development
# Comma-separated allowed CORS origins. Use "*" for dev/staging.
APP__CORS_ALLOWED_ORIGINS=*

AUTH__JWT_SECRET=dev-jwt-secret-REPLACE-WITH-32CHAR-RANDOM-VALUE-123
AUTH__JWT_EXPIRY_SECONDS=3600
AUTH__REFRESH_TOKEN_EXPIRY_SECONDS=604800

REDIS__URL=redis://localhost:6379

SERVICES__IDENTITY_URL=http://localhost:8001
SERVICES__CDP_URL=http://localhost:8002
SERVICES__ENGAGEMENT_URL=http://localhost:8003
SERVICES__ORDER_INTAKE_URL=http://localhost:8004
SERVICES__DISPATCH_URL=http://localhost:8005
SERVICES__DRIVER_OPS_URL=http://localhost:8006
SERVICES__DELIVERY_EXPERIENCE_URL=http://localhost:8007
SERVICES__PAYMENTS_URL=http://localhost:8008
SERVICES__FLEET_URL=http://localhost:8009
SERVICES__CARRIER_URL=http://localhost:8010
SERVICES__POD_URL=http://localhost:8011
SERVICES__ANALYTICS_URL=http://localhost:8013
SERVICES__MARKETING_URL=http://localhost:8014
SERVICES__BUSINESS_LOGIC_URL=http://localhost:8015
SERVICES__HUB_OPS_URL=http://localhost:8016
SERVICES__AI_LAYER_URL=http://localhost:8018
# Optional services — gateway returns 503/404 for their paths when unset.
SERVICES__COMPLIANCE_URL=http://localhost:8019
SERVICES__WEBHOOKS_URL=http://localhost:8020
SERVICES__CONNECTORS_URL=http://localhost:8021

RUST_LOG=info
